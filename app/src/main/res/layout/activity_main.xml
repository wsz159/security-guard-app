<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:id="@+id/shield_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:contentDescription="防护图标" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="防护已关闭"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="摇一摇手机，开启/关闭防护扫描"
            android:textSize="14sp"
            android:textColor="#757575" />

        <Button
            android:id="@+id/btn_manual_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="手动开启防护" />

        <Button
            android:id="@+id/btn_app_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="应用管理 / 卸载" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="后台防护（悬浮窗）"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="悬浮窗权限：未授予"
            android:textSize="12sp"
            android:textColor="#9E9E9E" />

        <TextView
            android:id="@+id/accessibility_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="无障碍服务：未开启"
            android:textSize="12sp"
            android:textColor="#9E9E9E" />

        <Button
            android:id="@+id/btn_request_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="授予悬浮窗权限" />

        <Button
            android:id="@+id/btn_request_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开启无障碍服务" />

        <Button
            android:id="@+id/btn_toggle_overlay_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启动后台防护服务" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一键清理"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="清除所有后台应用" />

        <TextView
            android:id="@+id/shizuku_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Shizuku 状态：检测中..."
            android:textSize="12sp"
            android:textColor="#9E9E9E" />

    </LinearLayout>
</ScrollView>
